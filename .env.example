# Copy to .env (git-ignored) and fill in. Real environment variables take precedence over this file.

# Required
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Optional. Any OpenAI-compatible chat-completions endpoint works (OpenAI, Groq, OpenRouter,
# Google Gemini's OpenAI-compatible endpoint, Ollama at http://localhost:11434/v1, vLLM, ...).
# LLM_BASE_URL=https://api.openai.com/v1

# Optional. Use "anthropic" to talk to the Anthropic Messages API instead
# (then LLM_BASE_URL defaults to https://api.anthropic.com and LLM_MODEL is a Claude model id).
# LLM_PROVIDER=openai

# Optional tuning
# LLM_TIMEOUT=120            # seconds per request
# LLM_MAX_RETRIES=3          # retries on timeouts / 429 / 5xx
# LLM_CONCURRENCY=3          # parallel chunk analyses for long PDFs
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_JSON_MODE=true         # set false if your endpoint rejects response_format
# MAX_PDF_MB=25
# MAX_PDF_PAGES=300
