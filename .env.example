# Copy to .env (git-ignored, never committed, excluded from the Docker image) and fill in.
# At least one provider key is required. Providers are tried in LLM_PROVIDERS order with automatic failover.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b

LLM_PROVIDERS=groq,openrouter,nvidia

# Groq's free tier allows ~8k tokens/minute per model: requests bigger than that are
# skipped instantly and go to OpenRouter / NVIDIA, so whole papers can be analysed in one call.
LLM_CONCURRENCY=3
LLM_MAX_OUTPUT_TOKENS=4000
SINGLE_PASS_CHARS=45000
CHUNK_CHARS=9000
NOTES_BUDGET_CHARS=9000

# Optional
# MAX_PDF_MB=25
# MAX_PDF_PAGES=300
# OCR_MODE=auto            # off to disable OCR
# JOBS_PER_IP_PER_HOUR=30
